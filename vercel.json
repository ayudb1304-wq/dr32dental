{
  "cleanUrls": true,
  "headers": [
    { "source": "/assets/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/(img|js|video)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] },
    { "source": "/(robots.txt|sitemap.xml)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
